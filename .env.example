# Server only. Leave blank to use process-local sample data.
# Set in the server environment; never prefix with VITE_.
DATABASE_URL=
# Example: postgresql://SERVER_ROLE:PASSWORD@HOST:5432/postgres?sslmode=require
# Production mode disables demo PIN staff writes and reset pending proper auth.
APP_ENV=demo
# Optional dedicated disposable database for integration tests (never production).
TEST_DATABASE_URL=
